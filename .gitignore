# .gitignore - MADRLCitytleranflexresdr (repositorio público de tesis)
# Solo se excluyen archivos de entorno local y generados temporales.
# Resultados, checkpoints y datos de entrenamiento SÍ se versionan.

# Cache Python
.cache/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales (locales, no de tesis)
venv/
ENV/
env/
# uc3m/env (UC3MEnv, BACT) es código fuente, no un entorno virtual.
!uc3m/env/
uc3m/env/__pycache__/
.venv
.venv*/
.venv39-citylearn-v3/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Notebooks checkpoints temporales
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Weights & Biases (no se usa)
wandb/
lightning_logs/

# Caché automática de CityLearn (regenerada en cada entorno, ~1 GB, no es dato de tesis)
data/cache/
outputs/dataset_cache/
*.pkl

# Checkpoints MAAC > 147 MB cada uno (exceden cuota LFS gratuita de GitHub 1 GB)
# Los resultados canónicos de MAAC (CSV, JSON, PNG) SÍ están versionados.
# Para reproducir: ejecutar train_citylearn_v3_maac.py desde Colab A100.
outputs/**/maac/**/checkpoints/*.pt
outputs/**/maac/**/checkpoints/model.pt
outputs/**/MAAC/**/checkpoint.pt

# Secrets de entorno (NUNCA versionar)
.env
.env.local
.env.*.local

# Credenciales y sesiones de conectores opcionales/legados
**/credentials.json
**/token.json
**/storage_state.json
**/browser-profile/
**/browser_profile/
**/user-data-dir/
**/playwright/.auth/

# Model weights / checkpoints — do not version (neither Git LFS nor regular blobs)
*.pt
*.pth
*.ckpt
*.safetensors

# Espacios de trabajo y cachés locales de ejecución Spec-Driven
.superpowers/sdd/
.specify/cache/


# Drive full_data timeseries (>100MB) — keep local, do not push to GitHub
outputs/_drive_madrl/**/timeseries.csv

# Generated local discovery links; canonical skill contents are tools/skills/.
/.agents/skills/
/.claude/skills/

# Temporales locales (SPEC-012/FR-012.3): usar .tmp/ para trabajo intermedio
/.tmp/
.git_commit_msg.tmp
**/_tmp_*
**/~$*

# Temporales de agentes y perfiles de navegador (H-07, H-08)
.codex_tmp/
tools/skills/notebooklm-mcp/data/browser_state/
tools/skills/google-drive-mcp/

