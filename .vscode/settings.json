{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv39-citylearn-v3\\Scripts\\python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}\\CityLearn"
  ],
  "python.analysis.ignore": [
    "CityLearn/examples/*.ipynb"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "warning"
  },
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.linting.pylintArgs": [
    "--max-line-length=88"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "CityLearn\\tests"
  ],
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD033": false,
    "MD041": false
  },
  "markdownlint.ignore": [
    "**/.venv*/**",
    "**/external/**",
    "**/outputs/**",
    "**/.git/**"
  ],
  "cSpell.language": "en,es-ES",
  "cSpell.words": [
    "CityLearn",
    "CityLearnV",
    "CTDE",
    "Dec",
    "HAPPO",
    "MAAC",
    "MADRL",
    "MARLISA",
    "MARLlib",
    "MASAC",
    "MATD3",
    "POMDP",
    "PyTorch",
    "RBC",
    "V2G",
    "checkpoints",
    "critic",
    "dataset",
    "datasets",
    "happo",
    "maac",
    "madrl",
    "marlisa",
    "masac",
    "matd3",
    "timeseries"
  ],
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true,
    "editor.rulers": [
      88
    ]
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  "notebook.output.wordWrap": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell 7.6 - CityLearn v3",
  "terminal.integrated.profiles.windows": {
    "PowerShell 7.6 - CityLearn v3": {
      "path": "C:\\Users\\Lenovo Legion\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoLogo",
        "-ExecutionPolicy",
        "Bypass",
        "-NoExit",
        "-File",
        "${workspaceFolder}\\scripts\\activate_citylearn_v3.ps1"
      ],
      "icon": "terminal-powershell"
    },
    "PowerShell 7.6": {
      "path": "C:\\Users\\Lenovo Legion\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoLogo"
      ],
      "icon": "terminal-powershell"
    },
    "PowerShell 7.5 MSI": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "args": [
        "-NoLogo"
      ],
      "icon": "terminal-powershell"
    },
    "Windows PowerShell": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "icon": "terminal-powershell"
    }
  },
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.cwd": "${workspaceFolder}"
}
