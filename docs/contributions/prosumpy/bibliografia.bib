% Bibliografia de soporte para los aportes/modificaciones a external/prosumpy
% Requisito: tesis doctorales/maestria y articulos cientificos 2021-2026
% (ver docs/decisions/ORGANIZACION_PROYECTO_DIAGNOSTICO_Y_PROPUESTA.md, Fase 7)
%
% Agregar una entrada BibTeX por cada referencia citada en CHANGES.md.
% Ejemplo de plantilla (completar con datos reales antes de citar):
%
% @phdthesis{apellido2024tesis,
%   title        = {Titulo de la tesis doctoral},
%   author       = {Apellido, Nombre},
%   year         = {2024},
%   school       = {Universidad},
%   type         = {Tesis doctoral}
% }
%
% @mastersthesis{apellido2023maestria,
%   title        = {Titulo de la tesis de maestria},
%   author       = {Apellido, Nombre},
%   year         = {2023},
%   school       = {Universidad},
%   type         = {Tesis de maestria}
% }
%
% @article{apellido2022articulo,
%   title        = {Titulo del articulo},
%   author       = {Apellido, Nombre and Apellido2, Nombre2},
%   journal      = {Revista},
%   year         = {2022},
%   volume       = {0},
%   pages        = {0--0},
%   doi          = {10.0000/0000}
% }
