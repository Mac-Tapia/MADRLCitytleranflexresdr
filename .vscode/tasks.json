{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CityLearn v3 MADRL - VER entrenamiento activo en terminal VS Code",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$root = Get-Content outputs\\latest_visible_training_output_root.txt; & scripts\\monitor_citylearn_training_visible.ps1 -OutputRoot $root -RefreshSeconds 30"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "CityLearn v3 MADRL - RELANZAR entrenamiento completo (4 algos x 3 escenarios)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$ts = Get-Date -Format 'yyyyMMdd_HHmmss'; $root = 'outputs\\citylearn_v3_madrl_full_' + $ts; Set-Content outputs\\latest_visible_training_output_root.txt $root; & scripts\\run_citylearn_v3_full_training_visible.ps1 -OutputRoot $root -Scenario ALL -Seed 0 -EpisodeTimeSteps 8760 -Episodes 5 -TorchThreads 12 -LiveProgressInterval 250 -Cuda -LiveOutput"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "CityLearn v3 MADRL - entrenamiento oficial visible",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\CityLearn\\scripts\\launch_citylearn_v3_official_training.ps1",
        "-Scenario",
        "ALL",
        "-Seed",
        "0",
        "-EpisodeTimeSteps",
        "8760",
        "-Episodes",
        "5",
        "-OutputRoot",
        "outputs\\citylearn_v3_madrl_official_full_cuda_v2",
        "-TorchThreads",
        "12",
        "-Cuda"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "CityLearn v3 MADRL - monitor visible",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\CityLearn\\scripts\\monitor_citylearn_v3_official_training.ps1",
        "-OutputRoot",
        "outputs\\citylearn_v3_madrl_official_full_cuda_v2",
        "-IntervalSeconds",
        "5",
        "-LogTail",
        "20"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "CityLearn v3 MADRL - validar contrato cooperativo CTDE",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv39-citylearn-v3\\Scripts\\python.exe",
      "args": [
        "-B",
        "CityLearn\\scripts\\validate_citylearn_v3_cooperative_ctde.py",
        "--output",
        "outputs\\citylearn_v3_madrl_official_full_cuda_v2\\cooperative_ctde_validation.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
