{
  "schema_version": 2,
  "project": "MADRLCitytleranflexresdr",
  "updated_at": "2026-06-25",
  "purpose": "Manifest canonico del flujo dataset -> carga -> entrenamiento -> comparacion -> resultados finales.",
  "technical_reports": [
    "docs/audits/INFORME_OPTIMIZACION_CITYLEARN_MADRL_VRAM.md",
    "docs/audits/INFORME_VALIDACION_RECOMPENSAS_MULTI_OBJETIVO_MADRL.md",
    "docs/audits/INFORME_CORRECCION_TRAZABILIDAD_MADRL_V4_2026-06-17.md"
  ],
  "dataset": {
    "name": "citylearn_iquitos_2023_2025",
    "schema_path": "CityLearn/data/datasets/citylearn_iquitos_2023_2025/schema.json",
    "buildings": 17,
    "hours": 26304,
    "active_csv_files": 222,
    "ev_chargers": 185,
    "ev_v2g_chargers": 31,
    "ev_mode3_physical_units": 96,
    "ev_mode3_sockets": 192,
    "ev_definition_count": 1850,
    "ev_nominal_power_kw": 749.4,
    "bess_capacity_kwh": 26266.0,
    "bess_nominal_power_kw": 6648.0,
    "pv_nominal_power_kwp": 48790.9,
    "audit_root": "data/dataset_audit",
    "required_audits": [
      "training_dataset_ready_manifest.json",
      "csv_integrity_manifest.json",
      "training_dataset_validation.json",
      "der_sizing_audit.json",
      "ev_charger_sizing_audit.json",
      "iquitos_citylearn_v3_dataset_evaluation.json",
      "workflow_integrity_manifest.json"
    ]
  },
  "workflow": [
    {
      "stage": "project_context",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/verify_project_context.ps1",
      "required_before": [
        "file_edits",
        "git_operations",
        "training_launch"
      ]
    },
    {
      "stage": "dataset_build",
      "command": ".venv39-citylearn-v3/Scripts/python.exe -B tools/orchestrate_citylearn_dataset.py --dataset-dir CityLearn/data/datasets/citylearn_iquitos_2023_2025",
      "outputs": [
        "CityLearn/data/datasets/citylearn_iquitos_2023_2025",
        "data/dataset_audit"
      ]
    },
    {
      "stage": "dataset_gate",
      "command": ".venv39-citylearn-v3/Scripts/python.exe -B tools/check_training_dataset_ready.py --manifest-out data/dataset_audit/training_dataset_ready_manifest.json",
      "acceptance": [
        "status=ready",
        "normalization_allowed_for_training=true"
      ]
    },
    {
      "stage": "workflow_integrity",
      "command": ".venv39-citylearn-v3/Scripts/python.exe -B tools/verify_workflow_integrity.py --manifest-out data/dataset_audit/workflow_integrity_manifest.json",
      "acceptance": [
        "ok=true",
        "no stale active defaults",
        "schema/training/docs linked"
      ]
    },
    {
      "stage": "training",
      "launcher": "CityLearn/scripts/launch_citylearn_v3_official_training.ps1",
      "wrapper": "scripts/run_citylearn_v3_full_training_visible.ps1",
      "active_output_pointer": "outputs/latest_visible_training_output_root.txt",
      "output_root_pattern": "outputs/citylearn_v3_madrl_full_<yyyyMMdd_HHmmss>",
      "algorithms": [
        "happo",
        "masac",
        "matd3",
        "maac"
      ],
      "scenarios": [
        "E1",
        "E2",
        "E3"
      ],
      "episodes": 17,
      "episode_time_steps": 8760,
      "num_env_steps": 148920,
      "artifact_profile": "efficient",
      "trace_record_interval": 10,
      "trace_detail": "compact",
      "gpu_profile": "local4060_fast",
      "cuda": true,
      "live_output": false,
      "parallel_scenarios": true,
      "max_concurrent_scenario_jobs": 2,
      "max_concurrent_heavy_jobs": 1,
      "parallelization_policy": "Visible monitoring is decoupled from rich per-job LiveOutput. On an 8 GB RTX 4060 Laptop GPU, HAPPO/MATD3 may run up to 2 scenarios concurrently; MASAC/MAAC remain capped at 1 for replay/critic memory stability. LiveOutput=true is reserved for sequential debugging.",
      "primary_training_runs": 12,
      "best_selection_required_line": "Mejor algoritmo MADRL seleccionado: [HAPPO / MASAC / MATD3 / MAAC]",
      "baseline_comparison": {
        "mode": "project_local_citylearn_v2",
        "internal_citylearn_v2_baseline": "evaluate_v2 written by every MADRL training run into objective_kpis/axis_baseline_comparison/baseline_gain_by_kpi",
        "benchmark_script": "CityLearn/scripts/benchmark_citylearn_v2_agents.py",
        "benchmark_agents_default": [
          "baseline",
          "hour_rbc"
        ],
        "comparator": "CityLearn/scripts/compare_citylearn_v2_vs_v3_madrl.py",
        "rule": "PPO/SAC/A2C are implemented only as CityLearn v2 central-agent Stable-Baselines3 comparison baselines on the same local Iquitos schema, not as MADRL v3 agents.",
        "sb3_comparison_agents": [
          "ppo",
          "sac",
          "a2c"
        ],
        "sb3_comparison_scripts": {
          "ppo": "CityLearn/scripts/benchmark_citylearn_v2_ppo.py",
          "sac": "CityLearn/scripts/benchmark_citylearn_v2_sac.py",
          "a2c": "CityLearn/scripts/benchmark_citylearn_v2_a2c.py"
        },
        "sb3_train_episodes": 50,
        "schema_path": "CityLearn/data/datasets/citylearn_iquitos_2023_2025/schema.json"
      }
    },
    {
      "stage": "monitoring",
      "primary_monitor": "CityLearn/scripts/monitor_citylearn_v3_official_training.ps1",
      "legacy_monitor_wrapper": "scripts/monitor_citylearn_training_visible.ps1",
      "status_files": [
        "official_full_status.json",
        "official_full_manifest.json"
      ],
      "transient_status_files": [
        "live_progress.json"
      ]
    },
    {
      "stage": "comparison",
      "v2_benchmark": "CityLearn/scripts/benchmark_citylearn_v2_agents.py",
      "v2_output_root": "outputs/citylearn_v2_original_benchmark",
      "v3_root_source": "outputs/latest_visible_training_output_root.txt",
      "comparator": "CityLearn/scripts/compare_citylearn_v2_vs_v3_madrl.py",
      "comparison_output_root": "outputs/comparison_citylearn_v2_vs_v3_madrl"
    },
    {
      "stage": "thesis_evidence",
      "generator": "CityLearn/scripts/generate_thesis_objective_evidence.py",
      "output_root": "outputs/thesis_objective_evidence"
    }
  ],
  "required_job_artifacts": [
    "data/results.json",
    "data/training_summary.json",
    "data/artifact_audit.json",
    "data/timeseries.csv",
    "data/trace.csv",
    "data/checkpoint_manifest.json",
    "figures/figures_manifest.json"
  ],
  "required_figures": [
    "reward_timeseries.png",
    "convergence_returns.png",
    "episode_reward_summary.png",
    "learning_efficiency.png",
    "citylearn_v2_district_timeseries.png",
