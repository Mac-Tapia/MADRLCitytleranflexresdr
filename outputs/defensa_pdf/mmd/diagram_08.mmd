    subgraph AWS["Produccion AWS EC2 (Ubuntu — A10G 24 GB)"]
        direction TB
        subgraph DOCKER["Docker Compose"]
            IMG["madrl-training:latest\nubuntu:22.04 + PyTorch cu126\nSin drivers en contenedor"]
