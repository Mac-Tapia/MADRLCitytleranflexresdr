{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv39-citylearn-v3\\Scripts\\python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}\\tools",
    "${workspaceFolder}\\CityLearn"
  ],
  "python.analysis.include": [
    "uc3m",
    "tests"
  ],
  "python.analysis.exclude": [
    "**/__pycache__",
    ".venv*/**",
    "CityLearn/**",
    "external/**",
    "outputs/**",
    "build/**",
    "dist/**",
    "agent-skills/**",
    "deploy/**",
    "tools/**"
  ],
  "python.analysis.ignore": [
    "CityLearn/**",
    "external/**",
    "outputs/**",
    "build/**",
    "dist/**",
    "agent-skills/**",
    "deploy/**",
    "tools/**"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "warning"
  },
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "ruff.lint.args": [
    "--exclude",
    "CityLearn",
    "--exclude",
    "external",
    "--exclude",
    "outputs",
    "--exclude",
    "build",
    "--exclude",
    "dist",
    "--exclude",
    "tools",
    "--exclude",
    "deploy",
    "--exclude",
    "agent-skills",
    "--exclude",
    ".venv39-citylearn-v3"
  ],
  "markdownlint.configFile": "${workspaceFolder}\\.markdownlint.json",
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD029": false,
    "MD031": false,
    "MD032": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD036": false,
    "MD033": false,
    "MD034": false,
    "MD040": false,
    "MD041": false,
    "MD058": false,
    "MD060": false
  },
  "markdownlint.ignore": [
    "**/.venv*/**",
    "**/external/**",
    "**/outputs/**",
    "**/.git/**",
    "**/CityLearn/**",
    "**/build/**",
    "**/dist/**",
    "**/agent-skills/**",
    "**/docs/thesis/**",
    "**/docs/audits/**",
    "**/docs/contributions/**"
  ],
  "cSpell.configFile": "${workspaceFolder}\\cspell.json",
  "cSpell.enabled": false,
  "cSpell.language": "en,es-ES",
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.ignorePaths": [
    "CityLearn/**",
    "external/**",
    "outputs/**",
    ".venv*/**",
    "build/**",
    "dist/**",
    "agent-skills/**",
    "docs/thesis/**",
    "docs/audits/**",
    "docs/contributions/**"
  ],
  "cSpell.words": [
    "BACT",
    "BESS",
    "CityLearn",
    "CityLearnV",
    "CTDE",
    "Dec",
    "HAPPO",
    "MAAC",
    "MADRL",
    "MARLISA",
    "MARLlib",
    "MASAC",
    "MATD3",
    "POMDP",
    "PyTorch",
    "RBC",
    "UC3M",
    "V2G",
    "checkpoints",
    "critic",
    "dataset",
    "datasets",
    "happo",
    "maac",
    "madrl",
    "marlisa",
    "masac",
    "matd3",
    "timeseries"
  ],
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true,
    "editor.rulers": [
      88
    ]
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  "notebook.output.wordWrap": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell 7.6 - CityLearn v3",
  "terminal.integrated.profiles.windows": {
    "PowerShell 7.6 - CityLearn v3": {
      "path": "C:\\Users\\Lenovo Legion\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoLogo",
        "-ExecutionPolicy",
        "Bypass",
        "-NoExit",
        "-File",
        "${workspaceFolder}\\scripts\\activate_citylearn_v3.ps1"
      ],
      "icon": "terminal-powershell"
    },
    "PowerShell 7.6": {
      "path": "C:\\Users\\Lenovo Legion\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
      "args": [
        "-NoLogo"
      ],
      "icon": "terminal-powershell"
    },
    "PowerShell 7.5 MSI": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "args": [
        "-NoLogo"
      ],
