# Variables de entorno compartidas para el stack de despliegue (demo)
# Copiar a .env y ajustar valores. No commitear .env real.

# --- inference-service ---
MODEL_PATH=/models/winning_agent.onnx
MODEL_METADATA_PATH=/models/winning_agent.metadata.json
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
LOG_LEVEL=info

# --- plant-adapter ---
INFERENCE_SERVICE_URL=http://inference-service:8000
ADAPTER_MODE=replay   # replay | modbus | opcua
REPLAY_DATASET_DIR=/data/citylearn_iquitos_2023_2025
REPLAY_SPEED=1.0
STEP_INTERVAL_SECONDS=1.0

# Modbus (solo si ADAPTER_MODE=modbus)
MODBUS_HOST=192.168.1.50
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# OPC-UA (solo si ADAPTER_MODE=opcua)
OPCUA_SERVER_URL=opc.tcp://192.168.1.50:4840

# MQTT (telemetria hacia dashboard / IoT Core)
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=madrl/iquitos/demo

# --- dashboard-service ---
DASHBOARD_PORT=8501

# --- AWS (solo docker-compose.aws.yml / aws/iac) ---
AWS_REGION=us-east-1
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPO_INFERENCE=madrl-iquitos/inference
ECR_REPO_PLANT_ADAPTER=madrl-iquitos/plant-adapter
ECR_REPO_DASHBOARD=madrl-iquitos/dashboard
S3_BUCKET_MODELS=madrl-iquitos-models
S3_BUCKET_DATASET=madrl-iquitos-dataset
S3_BUCKET_RESULTS=madrl-iquitos-results
